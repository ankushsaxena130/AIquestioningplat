# Copy this file to ".env" in this same folder (backend/.env) and fill
# in real values. main.py loads it automatically on startup via
# python-dotenv — nothing else to configure.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)

# Which LLM provider to use: "gemini", "openai", or "xai".
LLM_PROVIDER=gemini

# Only the key matching LLM_PROVIDER above needs to be set — the others
# can stay blank or be removed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

XAI_API_KEY=
XAI_MODEL=grok-4.3

# Optional — powers Friday's voice with Sarvam AI's Bulbul v3 model
# instead of the browser's built-in (more robotic) speech synthesis.
# Get a key at https://dashboard.sarvam.ai/ — free tier available.
# If left blank, Friday automatically falls back to browser TTS, so
# voice still works either way.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya

# Optional — only needed if you're using a real Postgres/Neon database
# instead of the default in-memory store.
DATABASE_URL=

# Optional — used to sign login tokens. Set this to a real random string
# in production; the app runs fine with the default for local dev.
JWT_SECRET=dev-only-insecure-secret-change-me
